{
  "expo": {
    "name": "SafeSafr",
    "slug": "safesafr",
    "version": "1.0.0",
    "scheme": "safesafr",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safesafr.app"
    },
    "android": {
      "package": "com.safesafr.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
   "plugins": [
  [
    "expo-image-picker",
    {
      "photosPermission": "Allow SafeSafar to access your photos to set a profile picture.",
      "cameraPermission": "Allow SafeSafar to access your camera to take a profile picture."
    }
  ]
]
  }
}
